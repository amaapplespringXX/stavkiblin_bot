# Токен бота от @BotFather
BOT_TOKEN=
# Юзернеймы админов через запятую, без @ (могут объявлять результат и отменять любые пари)
ADMIN_USERNAMES=AppleSpring,speafteam
# Порт HTTP-сервера (на wispbyte берётся из SERVER_PORT автоматически)
PORT=8080
# 1 = разрешить вход по имени вне Telegram (только для локальной отладки!)
DEV_MODE=0
# Публичный https-адрес мини-аппки — Render-прокси, например https://stavkiblin.onrender.com
# Бот ставит из него кнопку меню и пингует <URL>/proxy-health каждые 14 мин (anti-sleep)
WEBAPP_URL=
# Пути к TLS-сертификату, если вдруг терминируем TLS сами (в схеме с Render не нужны)
TLS_CERT=
TLS_KEY=
# Куда писать состояние (по умолчанию ./data/data.json)
DATA_FILE=
